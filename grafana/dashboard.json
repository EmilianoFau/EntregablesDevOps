          "values": [
            "value"
          ]
        },
        "displayLabels": [
          "percent"
        ]
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Escrituras por tipo (por minuto)",
      "description": "",
      "datasource": {
        "type": "prometheus",
